{
  "name": "dungeon-antiqua-zero",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run attack-poses:build && python3 -B app/main.py",
    "start:exhibition": "npm start -- --mode exhibition",
    "start:demo": "npm start -- --mode demo",
    "start:beta": "npm start -- --mode beta",
    "build:mac": "bash build.sh",
    "build:mac:exhibition": "npm run build:mac -- --mode exhibition",
    "build:mac:demo": "npm run build:mac -- --mode demo",
    "build:mac:beta": "npm run build:mac -- --mode beta",
    "build:win": "python -B scripts/build_windows.py",
    "build:win:exhibition": "npm run build:win -- --mode exhibition",
    "build:win:demo": "npm run build:win -- --mode demo",
    "build:win:beta": "npm run build:win -- --mode beta",
    "receive:win": "bash receive-windows.sh",
    "sync": "node scripts/sync-content.mjs",
    "get-data": "npm --prefix content run get-data && npm run sync",
    "put-data": "npm --prefix content run put-data",
    "image-build": "python3 scripts/build-images.py --allow-palette-mismatch",
    "audio:build": "python3 scripts/build-audio.py",
    "audio-build": "npm run audio:build",
    "map-build": "python3 -B scripts/compile-maps.py",
    "events-build": "python3 -B scripts/compile-events.py",
    "spell-effects:validate": "python3 -B scripts/compile-spell-effects.py --validate-only",
    "spell-effects:build": "python3 -B scripts/compile-spell-effects.py",
    "attack-poses:validate": "python3 -B scripts/compile-attack-poses.py --validate-only",
    "attack-poses:build": "python3 -B scripts/compile-attack-poses.py",
    "pyxel-edit": "pyxel edit app/assets",
    "editor": "python3 -B -m tools.editor",
    "test-battle": "npm run spell-effects:build && npm run attack-poses:build && python3 -B -m tools.screen_mocks.battle",
    "attack-pose-editor": "python3 -B -m tools.attack_pose_editor",
    "spell-effect-editor": "npm run image-build && python3 -B -m tools.spell_effect_editor"
  },
  "engines": {
    "node": ">=20"
  }
}
