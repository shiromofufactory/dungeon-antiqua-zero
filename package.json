{
  "name": "dungeon-antiqua-zero",
  "private": true,
  "type": "module",
  "scripts": {
    "content:init": "git submodule update --init --recursive && npm run content:sync",
    "content:sync": "node scripts/sync-content.mjs",
    "content:check": "node scripts/sync-content.mjs --check",
    "content:update": "git submodule update --remote --merge content && npm run content:sync",
    "content:validate": "npm --prefix content run validate",
    "content:get-data": "npm --prefix content run get-data",
    "content:put-data": "npm --prefix content run put-data",
    "content:put-data:dry-run": "npm --prefix content run put-data:dry-run",
    "images:build": "python3 scripts/build-images.py",
    "images:build:force": "python3 scripts/build-images.py --allow-palette-mismatch",
    "tools:pyxel-edit": "pyxel edit app/assets",
    "tools:image-viewer": "python3 -B -m tools.image_viewer",
    "tools:screen-mock:battle": "python3 -B -m tools.screen_mocks.battle",
    "tools:screen-mock:status": "python3 -B -m tools.screen_mocks.status",
    "tools:screen-mock:menu": "python3 -B -m tools.screen_mocks.menu",
    "portal:build": "npm --prefix content run portal:build",
    "portal:serve": "npm --prefix content run portal:serve",
    "portal:preview": "npm --prefix content run portal:preview"
  },
  "engines": {
    "node": ">=20"
  }
}
